@import "~/.cache/wal/colors-rofi-dark.rasi"

configuration {
    show-icons:                 false;
}

window {
    transparency:                "real";
    location:                    east;
    anchor:                      east;
    fullscreen:                  false;
    width:                       115px;
    x-offset:                    -15px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               20px;
    border-color:                @selected-normal-background;
    background-color:            @background;
}

mainbox {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px;
    padding:                     15px;
    border:                      3px solid;
    border-radius:               20px;
    border-color:                @selected-normal-background;
    background-color:            transparent;
    children:                    [ "listview" ];
}

message {
    enabled:                     true;
    margin:                      0px;
    padding:                     12px;
    border:                      23px solid;
    border-radius:               100%;
    border-color:                #00000000;
    background-color:            @alternate-normal-background;
    text-color:                  @foreground;
}

textbox {
    background-color:            inherit;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    placeholder-color:           @foreground;
    blink:                       true;
    markup:                      true;
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       5;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;

    spacing:                     15px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                #00000000;
    background-color:            transparent;
    text-color:                  @foreground;
}

element {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     20px 0px;
    border:                      2px solid;
    border-radius:               100%;
    border-color:                @selected-normal-background;
    background-color:            @selected-normal-background;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element-text {
    font:                        "feather bold 24";
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              -0.1;
    horizontal-align:            0.5;
}

element selected.normal {
    background-color:            @selected-normal-background;
    text-color:                  @background;
}